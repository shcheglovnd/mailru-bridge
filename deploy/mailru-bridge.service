# Install to /etc/systemd/system/mailru-bridge.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now mailru-bridge
# Adjust User/paths to your account. Binding 993/465 needs CAP_NET_BIND_SERVICE
# (granted below); use non-privileged ports and drop the capability lines otherwise.
[Unit]
Description=Mail.ru IMAP/SMTP bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Environment=HOME=/home/%i
WorkingDirectory=/home/%i/projects/mailru-bridge
ExecStart=/home/%i/projects/mailru-bridge/.venv/bin/mailru-bridge serve
Restart=on-failure
RestartSec=10
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
